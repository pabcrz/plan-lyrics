# Plantilla de variables de la API, sin valores reales: no versionar secretos.
# Local: copiá este archivo a .env.local (ignorado por Git). Vercel: definilas en el proyecto de la API
# (Settings > Environment Variables). DIRECT_URL no va en Vercel: ver docs/despliegue.md.

# Conexión AGRUPADA de la app (Neon: host con "-pooler"). La usa la API en ejecución.
DATABASE_URL=

# Conexión DIRECTA (Neon: host sin "-pooler"). Solo para migraciones: pnpm db:migrate:deploy.
DIRECT_URL=

# Secret key de Clerk (sk_...): solo servidor; permite crear cuentas e invitar.
CLERK_SECRET_KEY=

# Verificación de la sesión: clave pública PEM de la instancia (entre comillas, con saltos de línea) e issuer de la Frontend API.
CLERK_JWT_KEY=
CLERK_ISSUER=

# Origen EXACTO de la web que inicia sesión (claim azp), p. ej. https://app.tu-dominio.com. Sin barra final ni comodines.
CLERK_AUTHORIZED_PARTY=

# Origen(es) de la web autorizados por CORS, exactos y separados por comas. Normalmente igual a CLERK_AUTHORIZED_PARTY.
WEB_ORIGIN=

# Secreto de los enlaces del ministerio: al menos 32 caracteres aleatorios (ver docs/despliegue.md). Rotarlo invalida los enlaces.
SHARE_LINK_SECRET=
