{
  "name": "@plan-lyrics/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test:integration": "vitest run --config vitest.integration.ts",
    "build": "pnpm db:generate && tsc --noEmit false",
    "start": "node dist/index.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "3.26.6",
    "@hono/node-server": "2.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
