generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

// SINGLE is the only slot of ordinary dates; MORNING/AFTERNOON exist only on a double Sunday.
enum ServiceSlot {
  SINGLE
  MORNING
  AFTERNOON
}

enum ChurchRole {
  ADMIN
  EDITOR
  MEMBER
}

model User {
  id String @id @default(cuid())
  clerkSubject String @unique
  libraryEditor Boolean @default(false)
  // Global capability granted only by the platform owner; never grants church access.
  accountManager Boolean @default(false)
  memberships Membership[]
  person Person?
  ownership PlatformOwner?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformOwner {
  id Int @id @default(1)
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id String @id @default(cuid())
  name String
  // General personal data, shared by every church the person belongs to; optional.
  phone String?
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  churches ChurchPerson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Church {
  id String @id @default(cuid())
  name String
  // Opt-in per church: Sunday may then hold a morning (before 12:00) and an afternoon service.
  sundayDouble Boolean @default(false)
  // Opt-in per church: only stored and exposed for now; the preaching section does not exist yet.
  usesPreaching Boolean @default(false)
  people ChurchPerson[]
  memberships Membership[]
  services Service[]
  serviceDays ServiceDay[]
  closedDates ClosedDate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  userId String
  churchId String
  role ChurchRole
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([userId, churchId])
}

// One shared Person per human; church-specific data belongs to this link, never to Person.
model ChurchPerson {
  churchId String
  personId String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  directedServices Service[]
  // Removed from this church's directory: hidden from lists and pickers, kept for past services.
  removedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([churchId, personId])
  @@index([personId])
}

// Habitual day of a church (0 = Sunday). Only prefills the form; never creates services.
model ServiceDay {
  churchId String
  weekday Int
  slot ServiceSlot @default(SINGLE)
  time String
  title String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([churchId, weekday, slot])
}

model Service {
  id String @id @default(cuid())
  churchId String
  title String
  date DateTime @db.Date
  slot ServiceSlot @default(SINGLE)
  // Local start time "HH:mm" in America/Mexico_City; optional.
  time String?
  status ServiceStatus @default(DRAFT)
  directorId String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  // The director must belong to the same church: composite key, not just a Person id.
  director ChurchPerson @relation(fields: [churchId, directorId], references: [churchId, personId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([churchId, date, slot])
  @@index([churchId, date])
}

// «No hay culto»: a date without a meeting. It is not a service, nor a cancelled one.
model ClosedDate {
  churchId String
  date DateTime @db.Date
  // Optional short reason, e.g. a holiday.
  reason String?
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([churchId, date])
}
