generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

// SINGLE is the only slot of ordinary dates; MORNING/AFTERNOON exist only on a double Sunday.
enum ServiceSlot {
  SINGLE
  MORNING
  AFTERNOON
}

// How a role's rotation advances: one sequence per weekday, or one shared by every service.
enum RotationMode {
  BY_DAY
  SHARED
}

// Where an assignment came from: the role's habitual people, its rotation turn, or a manual change.
enum AssignmentSource {
  HABITUAL
  ROTATION
  MANUAL
}

// Why an assignment has no person: the proposals collided in a combination the church forbids,
// or its role was deleted while the service was still ahead.
enum PendingReason {
  COMBINATION
  ROLE_REMOVED
}

// What a ministry link shows: the praise side, the preaching side, or both with schedule and song order.
enum ShareVersion {
  PRAISE
  PREACHING
  FULL
}

enum ChurchRole {
  ADMIN
  EDITOR
  MEMBER
}

model User {
  id String @id @default(cuid())
  clerkSubject String @unique
  libraryEditor Boolean @default(false)
  // Global capability granted only by the platform owner; never grants church access.
  accountManager Boolean @default(false)
  memberships Membership[]
  person Person?
  ownership PlatformOwner?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformOwner {
  id Int @id @default(1)
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id String @id @default(cuid())
  name String
  // General personal data, shared by every church the person belongs to; optional.
  phone String?
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  churches ChurchPerson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Church {
  id String @id @default(cuid())
  name String
  // Opt-in per church: Sunday may then hold a morning (before 12:00) and an afternoon service.
  sundayDouble Boolean @default(false)
  // Opt-in per church: when off the API rejects every preaching read and write; stored data is kept.
  usesPreaching Boolean @default(false)
  // Set once the default musical roles and restriction were created; deleting every role never re-seeds them.
  rolesSeeded Boolean @default(false)
  people ChurchPerson[]
  musicalRoles MusicalRole[]
  roleRestrictions RoleRestriction[]
  rolePlans RolePlan[]
  assignments Assignment[]
  preachings ServicePreaching[]
  memberships Membership[]
  services Service[]
  serviceDays ServiceDay[]
  closedDates ClosedDate[]
  shareLinks ShareLink[]
  batchDirectors BatchDirectors?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  userId String
  churchId String
  role ChurchRole
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([userId, churchId])
}

// One shared Person per human; church-specific data belongs to this link, never to Person.
model ChurchPerson {
  churchId String
  personId String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  directedServices Service[]
  assignments Assignment[]
  preachings ServicePreaching[]
  // Removed from this church's directory: hidden from lists and pickers, kept for past services.
  removedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([churchId, personId])
  @@index([personId])
}

// Habitual day of a church (0 = Sunday). Only prefills the form; never creates services.
model ServiceDay {
  churchId String
  weekday Int
  slot ServiceSlot @default(SINGLE)
  time String
  title String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([churchId, weekday, slot])
}

model Service {
  id String @id @default(cuid())
  churchId String
  title String
  date DateTime @db.Date
  slot ServiceSlot @default(SINGLE)
  // Local start time "HH:mm" in America/Mexico_City; optional.
  time String?
  status ServiceStatus @default(DRAFT)
  directorId String
  // Bumped by every setlist change: a reorder sent with a stale version is rejected.
  setlistVersion Int @default(0)
  setlist SetlistEntry[]
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  // The director must belong to the same church: composite key, not just a Person id.
  director ChurchPerson @relation(fields: [churchId, directorId], references: [churchId, personId], onDelete: Restrict)
  assignments Assignment[]
  preaching ServicePreaching?
  shareLinks ShareLink[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([churchId, date, slot])
  // Lets dependent rows point at the service together with its church, so they cannot cross churches.
  @@unique([id, churchId])
  @@index([churchId, date])
}

// Preaching section of one service: it is not a musical role and grants no permission. The row exists only
// while something is filled in. The preacher is a directory person (no account required) of the same church;
// a person may direct and preach the same service. Notes are internal: never part of a public view.
model ServicePreaching {
  serviceId String @id
  churchId String
  preacherId String?
  topic String @default("")
  // Bible references, one per entry; plain text that is never interpreted.
  passages String[]
  // Internal notes in the minimal format of preaching-rules.ts (`- ` bullets, **bold**, __underline__).
  notes String @default("")
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId, churchId], references: [id, churchId], onDelete: Cascade)
  preacher ChurchPerson? @relation(fields: [churchId, preacherId], references: [churchId, personId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([serviceId, churchId])
  @@index([churchId, preacherId])
}

// «No hay culto»: a date without a meeting. It is not a service, nor a cancelled one.
model ClosedDate {
  churchId String
  date DateTime @db.Date
  // Optional short reason, e.g. a holiday.
  reason String?
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([churchId, date])
}

// Read-only ministry link, by one service or by a date range. The token is never stored: `nonce` plus the server
// secret derive it (see share-token.ts) and `tokenHash` finds the link. The content is read live, so the link
// follows later changes to the services it covers; only its validity is fixed (`activeUntil`).
model ShareLink {
  id String @id @default(cuid())
  churchId String
  nonce String
  tokenHash String @unique
  version ShareVersion
  fromDate DateTime @db.Date
  toDate DateTime @db.Date
  // Set when the link covers one service (then fromDate = toDate = its date).
  serviceId String?
  // Optional blocks chosen by whoever creates the link; tones/BPM and notes are off unless asked for.
  showKeys Boolean @default(false)
  showNotes Boolean @default(false)
  showPeople Boolean @default(true)
  // Last day (inclusive, America/Mexico_City) the link answers: 30 days after the last service it covers.
  activeUntil DateTime @db.Date
  revokedAt DateTime?
  // A deactivated link can be reactivated once; the strictest reading of an open product decision.
  reactivatedAt DateTime?
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId, churchId], references: [id, churchId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([churchId, createdAt])
}

// Musical role catalog of one church. «Dirigir» is a fixed service role and is not stored here.
model MusicalRole {
  id String @id @default(cuid())
  churchId String
  name String
  // Case- and accent-insensitive form of the name: unique per church.
  nameKey String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  plan RolePlan?
  assignments Assignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([churchId, nameKey])
}

// Unordered pair of roles one person cannot hold at once in a service. Each side is a MusicalRole id
// or the fixed key DIRIGIR; the pair is stored sorted (first < second) so it is unique and never self-paired.
model RoleRestriction {
  id String @id @default(cuid())
  churchId String
  first String
  second String
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([churchId, first, second])
}

// Continuity between monthly batches: the last ordered director list of the church and who was
// assigned last. One row per church; ids are not foreign keys (a removed person is filtered when read).
model BatchDirectors {
  churchId String @id
  directorIds String[]
  lastDirectorId String?
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shared music library (no lyrics or chords yet). A song is identified by title + author, compared
// without case, accents or repeated spaces: two songs may share a title if the author differs.
model Song {
  id String @id @default(cuid())
  title String
  author String
  titleKey String
  authorKey String
  entries SetlistEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([titleKey, authorKey])
}

// One line of a service setlist: a library song or a free-form moment (exactly one of songId / moment).
// The church is never stored here: it is always reached through the service.
model SetlistEntry {
  id String @id @default(cuid())
  serviceId String
  // 0-based and gapless; rewritten under the service row lock by every add, removal and reorder.
  position Int
  songId String?
  moment String?
  // Contextual key of this service ("G", "Bbm"); never edits the library.
  key String?
  // Manual reference link (YouTube or Spotify).
  link String?
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  song Song? @relation(fields: [songId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // A song appears once per setlist (null songId, i.e. moments, never collide).
  @@unique([serviceId, songId])
  @@unique([serviceId, position])
}

// Habitual people and rotation of one role of one church; never a property of the person. Person ids are
// not foreign keys: a person removed from the directory is filtered when read and when generating.
model RolePlan {
  roleId String @id
  churchId String
  // Habitual people in the order they were chosen.
  habitualIds String[]
  // Rotation switch and mode. Turning it off, or changing the mode, keeps every sequence so nothing is lost.
  rotationOn Boolean @default(false)
  mode RotationMode @default(BY_DAY)
  // Reference date: services before it get no rotation turn.
  startsOn DateTime? @db.Date
  role MusicalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sequences RotationSequence[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One ordered cycle of people. weekday 0-6 for BY_DAY, -1 for the one shared sequence. nextPersonId is the
// cursor: whoever takes the next generated service, kept across batches and months.
model RotationSequence {
  roleId String
  weekday Int
  memberIds String[]
  nextPersonId String?
  plan RolePlan @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([roleId, weekday])
}

// A person (or a pending marker) in one role of one service. roleName is a snapshot so past services keep
// their record after the role is deleted (roleId then becomes null); a future one becomes pending instead.
model Assignment {
  id String @id @default(cuid())
  churchId String
  serviceId String
  roleId String?
  roleName String
  personId String?
  source AssignmentSource
  // Present exactly when there is no person (also enforced by a database check).
  pending PendingReason?
  // For a COMBINATION pending: who the role's proposal had picked.
  proposedPersonId String?
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  role MusicalRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  person ChurchPerson? @relation(fields: [churchId, personId], references: [churchId, personId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([serviceId, roleId, personId])
  @@index([churchId, roleId])
  @@index([serviceId])
}
