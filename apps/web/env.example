# Plantilla de variables de la web, sin valores reales.
# Local: copiá este archivo a .env.local (ignorado por Git). Vercel: definí las variables en el proyecto de la web.
# Todo lo que empieza por VITE_ se incluye en el bundle del navegador: nunca pongas aquí una Secret key (sk_...).

# Publishable key de Clerk (pk_test_... en desarrollo, pk_live_... en producción).
VITE_CLERK_PUBLISHABLE_KEY=

# Origen de la API, sin barra final ni ruta, p. ej. https://api.tu-dominio.com.
# Déjala vacía en desarrollo local: Vite reenvía /api a http://127.0.0.1:3001.
VITE_API_URL=
